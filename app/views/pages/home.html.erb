<section id="contact" class="py-5">
  <div class="container">
    <h2 class="text-center mb-5">Contactez-moi</h2>
    <div class="text-center my-4">
      <a href="/cv_romain_buisine.pdf" class="btn btn-primary" download>Télécharger mon CV</a>
    </div>
    <%= form_with url: send_contact_message_path, method: :post, local: true, scope: :contact do |f| %>
  <div class="mb-3">
    <label for="contact_name" class="form-label">Nom</label>
    <%= f.text_field :name, id: "contact_name", class: "form-control", required: true %>
  </div>
  <div class="mb-3">
    <label for="contact_email" class="form-label">Email</label>
    <%= f.email_field :email, id: "contact_email", class: "form-control", required: true %>
  </div>
  <div class="mb-3">
    <label for="contact_message" class="form-label">Message</label>
    <%= f.text_area :message, id: "contact_message", class: "form-control", rows: 5, required: true %>
  </div>
  <button type="submit" class="btn btn-primary">Envoyer</button>
<% end %>

  </div>
</section>

